<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/audiobook_detail_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:transitionGroup="true">

    <com.auralis.player.ui.CoordinatorAppBarLayout
        android:id="@+id/audiobook_appbar"
        style="@style/Widget.Auralis.AppBarLayout"
        app:liftOnScroll="true"
        app:layout_behavior="com.auralis.player.detail.ContinuousAppBarLayoutBehavior"
        app:liftOnScrollTargetViewId="@id/audiobook_scroll_container">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/audiobook_collapsing_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:expandedTitleMargin="0dp"
            app:forceApplySystemWindowInsetTop="false"
            app:layout_scrollFlags="scroll|exitUntilCollapsed|snap"
            app:titleEnabled="false"
            app:toolbarId="@+id/audiobook_toolbar">

            <!-- Detail Header Shell -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/audiobook_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="?attr/colorSurfaceContainerLow"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingTop="?attr/actionBarSize"
                android:paddingEnd="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_medium"
                app:layout_collapseMode="parallax"
                app:layout_collapseParallaxMultiplier="0.85">

                <com.auralis.player.image.CoverView
                    android:id="@+id/audiobook_cover"
                    style="@style/Widget.Auralis.Image.MidLarge"
                    app:enablePlaybackIndicator="false"
                    app:enableSelectionBadge="false"
                    android:layout_marginTop="@dimen/spacing_medium"
                    android:layout_marginBottom="@dimen/spacing_medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/audiobook_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:text="@string/lbl_audiobook_mode"
                    android:textAppearance="?attr/textAppearanceLabelMediumEmphasized"
                    android:textColor="?attr/colorSecondary"
                    app:layout_constraintBottom_toTopOf="@+id/audiobook_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/audiobook_cover"
                    app:layout_constraintTop_toTopOf="@+id/audiobook_cover"
                    app:layout_constraintVertical_chainStyle="packed" />

                <TextView
                    android:id="@+id/audiobook_title"
                    style="@style/Widget.Auralis.TextView.Primary.Compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:ellipsize="end"
                    android:maxLines="2"
                    app:layout_constraintBottom_toTopOf="@+id/audiobook_author"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/audiobook_cover"
                    app:layout_constraintTop_toBottomOf="@+id/audiobook_type"
                    tools:text="Book Title" />

                <TextView
                    android:id="@+id/audiobook_author"
                    style="@style/Widget.Auralis.TextView.Secondary.Compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorSecondary"
                    app:layout_constraintBottom_toTopOf="@+id/audiobook_summary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/audiobook_cover"
                    app:layout_constraintTop_toBottomOf="@+id/audiobook_title"
                    tools:text="Author Name" />

                <TextView
                    android:id="@+id/audiobook_summary"
                    style="@style/Widget.Auralis.TextView.Secondary.Compact"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/spacing_medium"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?android:attr/textColorSecondary"
                    app:layout_constraintBottom_toBottomOf="@+id/audiobook_cover"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/audiobook_cover"
                    app:layout_constraintTop_toBottomOf="@+id/audiobook_author"
                    tools:text="5h 30m · 12 chapters" />

                <!-- Progress and controls in the header -->
                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/audiobook_progress_bar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="100"
                    app:indicatorColor="?attr/colorPrimary"
                    app:trackColor="?attr/colorSurfaceContainerHighest"
                    app:layout_constraintTop_toBottomOf="@+id/audiobook_cover"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:progress="45" />

                <TextView
                    android:id="@+id/audiobook_progress_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    app:layout_constraintTop_toBottomOf="@+id/audiobook_progress_bar"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    tools:text="45% · 2h 28m listened · 3h 02m remaining" />

                <!-- Primary Action & Secondary Actions Row -->
                <LinearLayout
                    android:id="@+id/audiobook_actions_container"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/audiobook_progress_text"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/audiobook_action_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lbl_audiobook_continue"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_play_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/audiobook_action_bookmarks"
                        style="?attr/materialButtonTonalStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/lbl_audiobook_bookmarks"
                        android:textAllCaps="false"
                        app:icon="@drawable/ic_bookmark_24" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/audiobook_action_reset"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/lbl_audiobook_reset_progress"
                        android:textAllCaps="false"
                        android:visibility="gone"
                        app:strokeColor="?attr/colorError"
                        app:iconTint="?attr/colorError" />
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                app:layout_collapseMode="pin" />

            <com.auralis.player.ui.AuralisToolbar
                android:id="@+id/audiobook_toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:layout_collapseMode="pin"
                app:navigationIcon="@drawable/ic_back_24" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.auralis.player.ui.CoordinatorAppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/audiobook_scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="64dp">

            <TextView
                android:id="@+id/audiobook_chapters_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/spacing_medium"
                android:paddingTop="@dimen/spacing_medium"
                android:paddingEnd="@dimen/spacing_medium"
                android:paddingBottom="@dimen/spacing_small"
                android:text="@string/lbl_audiobook_chapters"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <LinearLayout
                android:id="@+id/audiobook_chapters_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
