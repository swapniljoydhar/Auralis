<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ui_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:paddingStart="@dimen/spacing_medium"
    android:paddingTop="@dimen/spacing_mid_medium"
    android:paddingEnd="@dimen/spacing_mid_medium"
    android:paddingBottom="@dimen/spacing_mid_medium">

    <com.auralis.player.image.CoverView
        android:id="@+id/chapter_track_cover"
        style="@style/Widget.Auralis.Image.Small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/chapter_number"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textAlignment="center"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/sel_on_cover_bg"
            app:autoSizeMaxTextSize="@dimen/text_size_track_number_max"
            app:autoSizeMinTextSize="@dimen/text_size_track_number_min"
            app:autoSizeStepGranularity="@dimen/text_size_track_number_step"
            app:autoSizeTextType="uniform"
            tools:text="1" />

    </com.auralis.player.image.CoverView>

    <TextView
        android:id="@+id/chapter_title"
        style="@style/Widget.Auralis.TextView.Item.Primary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_mid_medium"
        android:textColor="@color/sel_selectable_text_primary"
        app:layout_constraintBottom_toTopOf="@+id/chapter_duration"
        app:layout_constraintEnd_toStartOf="@+id/chapter_check"
        app:layout_constraintStart_toEndOf="@+id/chapter_track_cover"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Chapter Title" />

    <TextView
        android:id="@+id/chapter_duration"
        style="@style/Widget.Auralis.TextView.Item.Secondary"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_medium"
        android:layout_marginEnd="@dimen/spacing_mid_medium"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/chapter_check"
        app:layout_constraintStart_toEndOf="@+id/chapter_track_cover"
        app:layout_constraintTop_toBottomOf="@+id/chapter_title"
        tools:text="45m 30s" />

    <ImageView
        android:id="@+id/chapter_check"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="@dimen/spacing_tiny"
        android:contentDescription="@string/lbl_audiobook_chapter_complete_short"
        android:src="@drawable/ic_check_24"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorPrimary"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
